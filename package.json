{
  "name": "os_easy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "main": "electron-main.cjs",
  "build": {
    "appId": "br.com.pracafe.smartmaint",
    "productName": "SMARTMAINT",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron-main.cjs", "package.json"],
    "extraResources": [{ "from": "data/os-easy-sync.json", "to": "data/os-easy-sync.json" }],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.35",
    "sqlite3": "^6.0.1",
    "tailwindcss": "^3.4.4",
    "vite": "^5.4.1"
  }
}
